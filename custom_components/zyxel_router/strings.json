  "issues": {
    "cellular_change_reverted": {
      "title": "Zyxel: cellular change reverted",
      "description": "After the change **{change}** the cellular connection did not come back within {timeout} seconds. The previous setting has been restored automatically. This message disappears after the next successful change."
    },
    "cellular_revert_failed": {
      "title": "Zyxel: restoring cellular settings failed",
      "description": "After the change **{change}** the cellular connection did not come back within {timeout} seconds, and restoring the previous setting failed. Check the router web interface (via LAN) and reset band/cell lock and network mode to automatic."
    }
  },
  "services": {
    "set_preferred_bands": {
      "name": "Set preferred bands",
      "description": "Restricts the modem to the given bands. Protected by the auto-revert watchdog.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "bands": {
          "name": "Bands",
          "description": "List like [\"B3\",\"B1\",\"n78\"] or [\"auto\"] for automatic."
        }
      }
    },
    "set_network_mode": {
      "name": "Set network mode",
      "description": "Sets the preferred access technology (watchdog protected).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "mode": {
          "name": "Mode",
          "description": "Access technology."
        }
      }
    },
    "set_cell_lock": {
      "name": "Set LTE cell lock",
      "description": "Locks LTE to up to 5 cells (watchdog protected).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "cells": {
          "name": "Cells",
          "description": "List of up to 5 cells, each with pci and earfcn (see example)."
        }
      }
    },
    "clear_cell_lock": {
      "name": "Clear LTE cell lock",
      "description": "Disables the LTE cell lock.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        }
      }
    },
    "set_nr_cell_lock": {
      "name": "Set 5G SA cell lock",
      "description": "Locks to a 5G cell. Only effective in 5G SA mode (watchdog protected).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "pci": {
          "name": "PCI",
          "description": "Physical cell ID."
        },
        "arfcn": {
          "name": "ARFCN",
          "description": "NR-ARFCN."
        },
        "band": {
          "name": "Band",
          "description": "NR band number, e.g. 78."
        },
        "scs": {
          "name": "SCS",
          "description": "Subcarrier spacing in kHz."
        }
      }
    },
    "clear_nr_cell_lock": {
      "name": "Clear 5G cell lock",
      "description": "Disables the 5G cell lock.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        }
      }
    },
    "delete_sms": {
      "name": "Delete SMS",
      "description": "Deletes an SMS from the inbox.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "index": {
          "name": "Index",
          "description": "Index of the message."
        }
      }
    },
    "dal_get": {
      "name": "Read DAL object",
      "description": "Reads any DAL OID from the router and returns it.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "oid": {
          "name": "OID",
          "description": "e.g. cellwan_status, status, wan"
        }
      }
    },
    "dal_set": {
      "name": "Write DAL object (expert)",
      "description": "Writes any DAL OID. NOT protected by the watchdog! Must be enabled in the options.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Zyxel device (optional with only one router)."
        },
        "oid": {
          "name": "OID",
          "description": "DAL object ID."
        },
        "method": {
          "name": "Method",
          "description": "HTTP method."
        },
        "payload": {
          "name": "Payload",
          "description": "JSON object to send."
        },
        "params": {
          "name": "Parameters",
          "description": "Additional query parameters (e.g. Index)."
        }
      }
    }
  }
}
